# Absolute path recommended. Defaults to <project>/.data
# PORTAL_DATA_DIR=/absolute/path/to/portal-data

# Server-only. Put the real key in .env.local (ignored by Git).
OPENROUTER_API_KEY=
# OpenRouter model ID, without the Mastra openrouter/ prefix.
OPENROUTER_MODEL=google/gemini-2.5-flash

# Local PostgreSQL and Better Auth. Generate secrets with npm run setup:local.
POSTGRES_USER=proximity
POSTGRES_PASSWORD=
POSTGRES_DB=proximity
POSTGRES_PORT=5433
DATABASE_URL=postgresql://proximity:YOUR_PASSWORD@127.0.0.1:5433/proximity
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:3001

# Worker budgets for the initial cheap-model integration (USD per UTC day).
AI_DAILY_BUDGET_USD=0.10
AI_APPLICATION_DAILY_BUDGET_USD=0.05
AI_REQUESTS_PER_MINUTE=20

# Optional private developer captures; exact signed-in user IDs, never role names.
ANALYSIS_DEBUG_CAPTURE=0
ANALYSIS_DEBUG_USER_IDS=

# Explicit local-only demo: no login screen, fixed seeded borrower/lender switch.
# Keep disabled outside the loopback demo. Requires setup:local seed accounts.
LOCAL_DEMO_MODE=0
